# Copy to .env for local dev. In production, set these as real environment
# variables in your host's dashboard (Render/Railway/Fly/Vercel) — never
# commit a real .env file.

PORT=8787

# --- Upstream API keys (server-side only) ---
FINNHUB_API_KEY=
COINMARKETCAP_API_KEY=

# --- Comma-separated list of frontend origins allowed to call this API.
# Example: https://app.moneymap.com,https://moneymap.com
# Leave empty for local development only.
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting (per IP) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Cache TTLs (ms) ---
CACHE_TTL_QUOTE_MS=30000
CACHE_TTL_SEARCH_MS=300000
CACHE_TTL_HISTORY_MS=300000

# --- Stripe (subscriptions) ---
# Both come from your Stripe Dashboard. The webhook secret specifically
# comes from Developers -> Webhooks -> your endpoint -> "Signing secret",
# after you've added this server's /api/stripe-webhook URL there.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The Price IDs for each plan, from Stripe Dashboard -> Product catalog.
# Each of your 4 plans (Single/Dual/Premium/Premium Plus) needs its own
# Stripe Product + Price set up first, then paste the Price ID (starts
# with "price_") here.
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_DUAL=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PLUS=

# Where Stripe sends the browser back to after checkout completes/cancels.
FRONTEND_URL=http://localhost:5173

# --- Supabase ---
# Same Project URL as the frontend uses, but the SERVICE ROLE key here -
# not the anon key. Get it from Project Settings -> API -> service_role.
# This key bypasses Row Level Security, so it must only ever live here,
# never in frontend code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
